{
  "name": "cafeclick",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @cafeclick/web dev",
    "dev:api": "pnpm --filter @cafeclick/api dev",
    "generate:web": "pnpm --filter @cafeclick/web generate",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "typescript-eslint": "^8.72.2",
    "vue-eslint-parser": "^10.4.2"
  },
  "dependencies": {
    "pnpm": "^12.23.0"
  }
}
